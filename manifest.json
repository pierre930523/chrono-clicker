{
  "manifest_version": 3,
  "name": "ChronoClicker - 高精準世界時間倒數點擊器",
  "version": "1.0.0",
  "description": "支援全球地區時區轉換、原子鐘微秒級校準、網頁可視化元素拾取與極限精度倒數定時點擊。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ChronoClicker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content_script.js"],
      "css": ["content/content_style.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/content_style.css",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
